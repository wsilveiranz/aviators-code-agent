# Azure OpenAI Configuration
# Copy this file to .env and fill in your values

AZURE_OPENAI_ENDPOINT=https://ws-open-ai.cognitiveservices.azure.com/
AZURE_OPENAI_API_KEY=your-api-key-here
AZURE_OPENAI_API_VERSION=2025-01-01-preview
AZURE_OPENAI_MODEL=gpt-5-2

# EmailCompanion MCP Server
EMAIL_MCP_ENDPOINT=your-email-mcp-endpoint-url
EMAIL_MCP_API_KEY=your-email-mcp-api-key

# Playwright MCP (optional - set for deployed/sidecar mode, omit for local stdio)
# PLAYWRIGHT_MCP_URL=http://localhost:8080
# PLAYWRIGHT_MCP_PATH=C:\dev\playwright-mcp\packages\playwright-mcp\cli.js
# PLAYWRIGHT_STORAGE_PATH=C:\dev\aviator-newsletter-agent\.github\tools\playwright-login\storage.json
