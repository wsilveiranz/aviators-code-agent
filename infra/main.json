      ]
    },
    {
      "type": "Microsoft.Authorization/roleAssignments",
      "apiVersion": "2022-04-01",
      "scope": "[resourceId('Microsoft.ContainerRegistry/registries', 'acrAviators')]",
      "name": "[guid(resourceId('Microsoft.App/containerApps', 'ca-aviators-agents'), resourceId('Microsoft.ContainerRegistry/registries', 'acrAviators'), variables('acrPullRole'))]",
      "properties": {
        "roleDefinitionId": "[variables('acrPullRole')]",
        "principalId": "[reference(resourceId('Microsoft.App/containerApps', 'ca-aviators-agents'), '2024-03-01', 'full').identity.principalId]",
        "principalType": "ServicePrincipal"
      },
      "dependsOn": [
        "[resourceId('Microsoft.ContainerRegistry/registries', 'acrAviators')]",
        "[resourceId('Microsoft.App/containerApps', 'ca-aviators-agents')]"
      ]
    }
  ],
  "outputs": {
