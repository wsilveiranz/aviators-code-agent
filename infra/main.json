      "value": "[format('https://{0}', reference(resourceId('Microsoft.Web/staticSites', 'swa-aviators-ui'), '2023-12-01').defaultHostname)]"
    },
    "staticWebAppDeploymentToken": {
      "type": "string",
      "value": "[listSecrets(resourceId('Microsoft.Web/staticSites', 'swa-aviators-ui'), '2023-12-01').properties.apiKey]"
    },
    "containerAppPrincipalId": {
