{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "CommonJS",
    "moduleResolution": "Node",
    "noEmit": false,
    "outDir": "out",
    "rootDir": ".",
    "types": [
      "node"
    ]
  },
  "include": [
    "src/core/**/*.ts",
    "src/skills/**/*.ts",
    "src/tools/**/*.ts",
    "src/prompts/**/*.ts",
    "src/extension/communityGeneration.ts",
    "src/extension/toolResult.ts",
    "test/**/*.ts"
  ],
  "exclude": [
    "dist",
    "node_modules",
    "out",
    "src/extension"
  ]
}
