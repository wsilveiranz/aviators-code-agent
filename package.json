{
  "name": "aviators-code-agent",
  "version": "1.0.0",
  "description": "Logic Apps Aviators Newsletter Editor Agent using Copilot SDK",
  "type": "module",
  "main": "src/index.js",
  "scripts": {
    "start": "concurrently -n server,ui -c blue,green \"npm run server\" \"npm run ui\"",
    "server": "node src/server.js",
    "ui": "cd ui && npm run dev",
    "chat": "node src/chat.js",
    "dev": "node --watch src/chat.js",
    "info": "node src/index.js",
    "demo": "node src/index.js --demo",
    "test": "node test/run.js",
    "test:skills": "node src/test-productGroup.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.50.0",
    "@azure-rest/ai-inference": "^1.0.0-beta.6",
    "@azure/core-auth": "^1.10.1",
    "@azure/identity": "^4.13.0",
    "@azure/monitor-opentelemetry": "^1.15.1",
    "@modelcontextprotocol/sdk": "^1.25.3",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/resources": "^2.5.0",
    "concurrently": "^9.1.2",
    "cors": "^2.8.6",
    "dotenv": "^17.2.3",
    "express": "^5.2.1",
    "openai": "^6.17.0",
    "playwright": "^1.42.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
